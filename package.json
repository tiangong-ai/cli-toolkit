{
  "name": "@tiangong-ai/cli",
  "version": "0.0.64",
  "description": "Tiangong AI command-line interface.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tiangong-ai/cli-toolkit.git"
  },
  "homepage": "https://github.com/tiangong-ai/cli-toolkit#readme",
  "bugs": {
    "url": "https://github.com/tiangong-ai/cli-toolkit/issues"
  },
  "type": "module",
  "bin": {
    "tiangong-ai": "bin/tiangong-ai.js"
  },
  "files": [
    "bin/",
    "dist/",
    "README.md",
    "CONTRIBUTING.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run clean && npm run build",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --import tsx --test test/*.test.ts",
    "test:platform": "npm run build && node --import tsx --test test/research-platform-contract.test.ts",
    "test:coverage": "npm run build && node ./scripts/run-test-coverage.cjs",
    "test:container": "node ./scripts/assert-clean-container.mjs && npm run lint && npm run typecheck && npm run test:coverage",
    "test:clean": "sh ./scripts/test-clean-container.sh",
    "test:clean:cold": "sh ./scripts/test-clean-container.sh --cold-build",
    "audit:research-setup-pins": "npm run build && node ./scripts/audit-research-setup-pins.mjs",
    "prepush:gate": "npm run test:clean && docpact validate-config --root . --strict && docpact lint --root . --worktree --mode enforce",
    "lint": "npm run lint:format && npm run lint:coverage-guards",
    "lint:format": "prettier --check \"{src,test,bin,scripts}/**/*.{ts,js,cjs,mjs}\" \"*.{md,json}\" \"docs/**/*.md\" \".docpact/**/*.yaml\" \".github/**/*.yml\"",
    "lint:coverage-guards": "node ./scripts/assert-no-coverage-ignore.cjs",
    "format": "prettier --write \"{src,test,bin,scripts}/**/*.{ts,js,cjs,mjs}\" \"*.{md,json}\" \"docs/**/*.md\" \".docpact/**/*.yaml\" \".github/**/*.yml\"",
    "clean": "node --eval \"import('node:fs').then(({ rmSync }) => rmSync('dist', { recursive: true, force: true }))\""
  },
  "engines": {
    "node": ">=24 <25"
  },
  "keywords": [
    "tiangong",
    "ai",
    "cli",
    "kb",
    "research"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.12.2",
    "@types/proper-lockfile": "^4.1.4",
    "c8": "^12.0.0",
    "prettier": "^3.8.1",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1056.0",
    "ajv": "8.20.0",
    "pdf-lib": "^1.17.1",
    "proper-lockfile": "^4.1.2",
    "sharp": "^0.35.3",
    "undici": "7.29.1",
    "yaml": "2.9.0"
  }
}
